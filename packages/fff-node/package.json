{
  "name": "@sakiori/fff-node",
  "version": "0.1.37",
  "private": false,
  "description": "Fuzzy file finder for Node.js over the shared fff service - perfect for LLM agent tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types",
    "build:bundle": "tsup src/index.ts src/watch-delivery.ts --format esm --platform node --target node20 --external ffi-rs --sourcemap",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 test/e2e.mjs test/service.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "freebsd"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/sakiori-oss/fff.git",
    "directory": "packages/fff-node"
  },
  "keywords": [
    "file-finder",
    "fuzzy-search",
    "node",
    "ffi",
    "llm-tools",
    "agent-tools",
    "fast",
    "rust"
  ],
  "author": "Dmitry Kovalenko",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://gitlab.com/sakiori-oss/fff/-/issues"
  },
  "homepage": "https://gitlab.com/sakiori-oss/fff#readme",
  "dependencies": {
    "ffi-rs": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0"
  }
}
